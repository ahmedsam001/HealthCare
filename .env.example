# Environment variable template for the Healthcare Real-Time Risk Monitoring Platform
#
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your credentials
#   source .env

# ── Snowflake ────────────────────────────────────────────────────────────────

# REQUIRED: Your Snowflake account password
SNOWFLAKE_PASSWORD=

# Optional overrides (defaults shown)
# SNOWFLAKE_ACCOUNT=zj90931.eu-central-2.aws
# SNOWFLAKE_USER=ahmedSami
# SNOWFLAKE_DATABASE=HEALTHCARE_DB
# SNOWFLAKE_WAREHOUSE=HEALTHCARE_WH
# SNOWFLAKE_ROLE=ACCOUNTADMIN

# ── Kafka ────────────────────────────────────────────────────────────────────

# Optional overrides (defaults shown)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_TOPIC=medical-events

# ── ML Models ────────────────────────────────────────────────────────────────

# Optional: absolute path to the models/ directory
# Defaults to <project_root>/models/
# MODEL_DIR=/absolute/path/to/models
